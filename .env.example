# PostgreSQL exclusiva del microservicio de autenticación.
AUTH_DATABASE_URL=postgres://auth_user:change_me@localhost:5432/whatsapp_auth?sslmode=disable

# Backend Spring Boot y secreto compartido entre servicios.
BACKEND_INTERNAL_URL=http://localhost:8080
INTERNAL_SERVICE_TOKEN=replace_with_a_long_random_secret

# Clave privada RSA PEM para firmar access tokens.
AUTH_PRIVATE_KEY_PATH=/absolute/path/to/signing-key.pem

# Deben coincidir con AUTH_ISSUER y AUTH_AUDIENCE del backend.
AUTH_ISSUER=http://localhost:8081
AUTH_AUDIENCE=whatsapp-commerce-api

# Configuración opcional.
AUTH_LISTEN_ADDRESS=:8081
AUTH_KEY_ID=auth-rsa-1
AUTH_ALLOWED_ORIGINS=http://localhost:4200
AUTH_REFRESH_COOKIE_NAME=auth_refresh
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
